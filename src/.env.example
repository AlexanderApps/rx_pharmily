# Copy this file to .env and fill in your project's real values, found in
# your Supabase project settings under Project Settings > API.
#
# The EXPO_PUBLIC_ prefix is required — Expo only inlines env vars into the
# app bundle when they're prefixed this way. Anything without it stays
# server-only and won't be readable from app code.
#
# Restart the dev server after creating or editing this file — Expo reads
# .env at startup only, not on hot reload.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The anon key is safe to ship in the app (it's what Supabase's row-level
# security policies are designed to be used with) but the real .env file
# should still be gitignored — don't commit it, since a project-specific
# URL/key pair is still project-identifying information.
